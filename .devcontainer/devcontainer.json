// For format details, see https://aka.ms/devcontainer.json.
{
	"name": "joaoportela.net",
	"image": "mcr.microsoft.com/devcontainers/javascript-node:4-24-trixie",
	"features": {
		"ghcr.io/devcontainers-extra/features/mise:1": {}
	},

	"containerEnv": {
		"MISE_TRUSTED_CONFIG_PATHS": "${containerWorkspaceFolder}"
	},
	// The mise feature only installs the binary; shims make the mise.toml tools available to every shell.
	"remoteEnv": {
		"PATH": "/home/node/.local/share/mise/shims:${containerEnv:PATH}"
	},
	"postCreateCommand": "mise install && npm install",

	"forwardPorts": [8000],
	"portsAttributes": {
		"8000": {
			"label": "mise run serve",
			"onAutoForward": "notify"
		}
	},

	"customizations": {
		"vscode": {
			"settings": {
				"editor.formatOnSave": true
			},
			"extensions": [
				"streetsidesoftware.code-spell-checker",
				"esbenp.prettier-vscode"
			]
		}
	}
}
